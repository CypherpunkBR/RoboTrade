# ╔═══════════════════════════════════════════════════════════════╗
# ║  RoboTrade - PRE-COMMIT HOOK                                  ║
# ║  Validações de qualidade antes de cada commit                 ║
# ║  Tempo esperado: ~15-45s                                      ║
# ╚═══════════════════════════════════════════════════════════════╝

echo "🔍 Pre-commit: Executando verificações de qualidade..."
echo ""

# Salva arquivos staged para re-adicionar depois
STAGED_FILES=$(git diff --cached --name-only)

# ═════════════════════════════════════════════════════════════════
# 1. Lint-Staged (valida arquivos .rs modificados)
# ═════════════════════════════════════════════════════════════════
echo "📝 [1/3] Validando arquivos Rust modificados..."

npx lint-staged > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "   ❌ Lint-staged falhou"
  exit 1
fi
echo "   ✅ Lint-staged OK"

# ═════════════════════════════════════════════════════════════════
# 2. Cargo Check (verifica compilação)
# ═════════════════════════════════════════════════════════════════
echo ""
echo "🔨 [2/3] Verificando compilação..."

cargo check --workspace --all-targets --all-features > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "   ❌ Erro de compilação (run: npm run rust:check)"
  exit 1
fi
echo "   ✅ Compilação OK"

# ═════════════════════════════════════════════════════════════════
# 3. Cargo Clippy (lints rigorosos)
# ═════════════════════════════════════════════════════════════════
echo ""
echo "🔎 [3/3] Verificando qualidade de código (clippy)..."

cargo clippy --workspace --all-targets --all-features -- -D warnings > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "   ❌ Clippy encontrou problemas (run: npm run rust:clippy)"
  exit 1
fi
echo "   ✅ Clippy OK"

# Re-adiciona arquivos staged (caso tenham sido modificados por fmt)
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo ""
echo "✅ Pre-commit: Todas as verificações passaram!"
