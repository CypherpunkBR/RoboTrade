# ╔═══════════════════════════════════════════════════════════════╗
# ║  RoboTrade - PRE-PUSH HOOK                                    ║
# ║  Validações abrangentes antes de push                        ║
# ║  Tempo esperado: 2-5 minutos                                 ║
# ║  Skip: SKIP_PRE_PUSH=1 git push OR git push --no-verify     ║
# ║                                                               ║
# ║  NOTA: Validações básicas (fmt, clippy, check) já foram     ║
# ║        feitas no pre-commit. Aqui validamos testes,          ║
# ║        segurança, build release e duplicação de código.      ║
# ╚═══════════════════════════════════════════════════════════════╝

echo "🚀 Pre-push: Executando validações abrangentes..."
echo ""

# Check skip flags
if [ -n "$SKIP_PRE_PUSH" ] || [ -n "$NO_VERIFY" ]; then
  echo "⚠️  Pulando validações (SKIP_PRE_PUSH ou --no-verify)"
  exit 0
fi

CRITICAL=0

# ═════════════════════════════════════════════════════════════════
# 1. RUST TESTS
# ═════════════════════════════════════════════════════════════════
echo "🧪 [1/6] Testes Rust..."

cargo test --workspace --all-features > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "   ❌ Testes falharam (run: npm run rust:test)"
  CRITICAL=$((CRITICAL + 1))
else
  echo "   ✅ Testes OK"
fi

# ═════════════════════════════════════════════════════════════════
# 2. CODE DUPLICATION (Rust)
# ═════════════════════════════════════════════════════════════════
echo ""
echo "🔍 [2/6] Duplicação de Código (Rust)..."

if command -v jscpd > /dev/null 2>&1; then
  npm run -s cpd:rust:check > /dev/null 2>&1
  if [ $? -ne 0 ]; then
    echo "   ⚠️  Duplicação >5% encontrada (não bloqueante)"
  else
    echo "   ✅ Duplicação OK"
  fi
else
  echo "   ⚠️  jscpd não instalado (npm install -g jscpd)"
fi

# ═════════════════════════════════════════════════════════════════
# 3. RUST SECURITY (cargo-audit)
# ═════════════════════════════════════════════════════════════════
echo ""
echo "🔒 [3/6] Auditoria de Segurança..."

if command -v cargo-audit > /dev/null 2>&1; then
  cargo audit > /dev/null 2>&1
  if [ $? -ne 0 ]; then
    echo "   ❌ Vulnerabilidades encontradas (run: npm run rust:audit)"
    CRITICAL=$((CRITICAL + 1))
  else
    echo "   ✅ Sem vulnerabilidades"
  fi
else
  echo "   ⚠️  cargo-audit não instalado"
  echo "      Install: cargo install cargo-audit"
fi

# ═════════════════════════════════════════════════════════════════
# 4. DOCUMENTATION BUILD
# ═════════════════════════════════════════════════════════════════
echo ""
echo "📚 [4/6] Build da Documentação..."

cargo doc --workspace --no-deps --all-features > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "   ❌ Erro na documentação (run: npm run rust:doc)"
  CRITICAL=$((CRITICAL + 1))
else
  echo "   ✅ Documentação OK"
fi

# ═════════════════════════════════════════════════════════════════
# 5. RELEASE BUILD
# ═════════════════════════════════════════════════════════════════
echo ""
echo "🔨 [5/6] Build Release..."

cargo build --workspace --release > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "   ❌ Build release falhou (run: npm run rust:build:release)"
  CRITICAL=$((CRITICAL + 1))
else
  echo "   ✅ Build release OK"
fi

# ═════════════════════════════════════════════════════════════════
# 6. UNUSED DEPENDENCIES (cargo-machete)
# ═════════════════════════════════════════════════════════════════
echo ""
echo "🧹 [6/6] Dependências Não Utilizadas..."

if command -v cargo-machete > /dev/null 2>&1; then
  cargo machete > /dev/null 2>&1
  MACHETE_CODE=$?

  if [ $MACHETE_CODE -eq 1 ]; then
    echo "   ⚠️  Dependências não utilizadas (não bloqueante)"
  elif [ $MACHETE_CODE -eq 0 ]; then
    echo "   ✅ Sem dependências não utilizadas"
  else
    echo "   ⚠️  Erro no cargo-machete"
  fi
else
  echo "   ⚠️  cargo-machete não instalado"
  echo "      Install: cargo install cargo-machete"
fi

# ═════════════════════════════════════════════════════════════════
# FINAL DECISION
# ═════════════════════════════════════════════════════════════════
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

if [ $CRITICAL -ge 1 ]; then
  echo "❌ Push BLOQUEADO - $CRITICAL falha(s) crítica(s)"
  echo ""
  echo "💡 Para pular (use com cautela):"
  echo "   • SKIP_PRE_PUSH=1 git push"
  echo "   • git push --no-verify"
  echo ""
  exit 1
else
  echo "✅ Todas as validações passaram!"
  echo "🎉 Push permitido!"
  echo ""
  exit 0
fi
