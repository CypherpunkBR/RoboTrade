{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoboTrade",
  "version": "0.1.0",
  "identifier": "br.com.cypherpunk.robotrade",
  "build": {
    "beforeDevCommand": {
      "cwd": "../src-web",
      "script": "pnpm dev"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "cwd": "../src-web",
      "script": "pnpm build"
    },
    "frontendDist": "../src-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RoboTrade",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "category": "Finance",
    "shortDescription": "Robô de Trading Automatizado",
    "longDescription": "RoboTrade é um robô de trading automatizado focado em criptomoedas, com estratégias baseadas em indicadores técnicos e sentimento de mercado."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
