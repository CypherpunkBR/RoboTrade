# RoboTrade - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commit o arquivo .env com credenciais reais!

# =============================================================================
# Binance Futures
# =============================================================================
# Obtenha suas chaves em: https://www.binance.com/en/my/settings/api-management
# Para testnet: https://testnet.binancefuture.com/

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use testnet para desenvolvimento (true/false)
BINANCE_TESTNET=true

# =============================================================================
# Kraken Futures
# =============================================================================
# Obtenha suas chaves em: https://futures.kraken.com/trade/settings/api
# Para demo: https://demo-futures.kraken.com

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Use demo para desenvolvimento (true/false)
KRAKEN_DEMO=true

# =============================================================================
# Configurações da Aplicação
# =============================================================================

# Nível de log: trace, debug, info, warn, error
RUST_LOG=info

# Caminho personalizado para configuração (opcional)
# ROBOTRADE_CONFIG=/path/to/config.toml

# Caminho personalizado para dados (opcional)
# ROBOTRADE_DATA=/path/to/data

# =============================================================================
# Desenvolvimento
# =============================================================================

# Ambiente: development, staging, production
ROBOTRADE_ENV=development
