{
  "threshold": 5,
  "reporters": ["console", "json"],
  "ignore": [
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/*.config.*",
    "**/vite-env.d.ts"
  ],
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "minLines": 5,
  "minTokens": 50,
  "maxLines": 500,
  "maxSize": "100kb",
  "output": "./reports/jscpd",
  "formatsExts": {
    "typescript": ["ts"],
    "tsx": ["tsx"],
    "javascript": ["js"],
    "jsx": ["jsx"]
  },
  "absolute": true,
  "skipLocal": false,
  "blame": false,
  "silent": false,
  "verbose": false
}
